# ==============================================================================
# ChainSentry Environment Configuration Template
# Copy this file to .env for local development or configure in your cloud host.
# ==============================================================================

# Application & Environment
APP_NAME=ChainSentry
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Security (CRITICAL: Change SECRET_KEY before deploying to production!)
SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Origins (Comma-separated list of allowed origins, or * for all)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:8000

# Database Configuration
# Default: Zero-daemon SQLite (offline-first, no external DB needed)
DATABASE_URL=sqlite:///chainsentry.db
# PostgreSQL Example (Production):
# DATABASE_URL=postgresql://user:password@localhost:5432/chainsentry

# Optional External Neo4j Graph Database
# (In-memory NetworkX engine runs automatically if disabled or unreachable)
ENABLE_NEO4J=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=chainsentry123

# Optional Task Queue & Redis
CELERY_ALWAYS_EAGER=true
REDIS_URL=redis://localhost:6379/0

# Heuristics & Anomaly Thresholds
ANOMALY_PERCENTILE_THRESHOLD=0.85
MAX_HOPS_PEELING_CHAIN=15
MIN_HOPS_PEELING_CHAIN=3
COINJOIN_MIN_EQUAL_OUTPUTS=3

# Optional AI LLM Narrative Generation (Anthropic Claude)
ENABLE_LLM_NARRATIVE=false
ANTHROPIC_API_KEY=
